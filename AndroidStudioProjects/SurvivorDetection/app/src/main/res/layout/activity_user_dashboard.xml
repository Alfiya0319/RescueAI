<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:src="@drawable/ic_app"
                android:scaleType="fitCenter"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back"
                    android:textColor="#64748B"
                    android:textSize="20sp"
                    android:includeFontPadding="false"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="Rescue AI"
                    android:textColor="#FFFFFF"
                    android:textSize="45sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textColor="#FF4D6D"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/ivHeroBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/banner_rescue_ai" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#AA000000" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:letterSpacing="0.15"
                        android:text="DISASTER RESPONSE UNIT"
                        android:textColor="#FF4D6D"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="AI-Powered Survivor Detection"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real-time · Instant Alerts · Save Lives"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/badge_role_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● LIVE"
                        android:textColor="#FF4D6D"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/dark_card_bg"
                    android:layout_marginEnd="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Active Teams" android:textColor="#64748B" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="24/7" android:textColor="#FF4D6D"
                        android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/dark_card_bg"
                    android:layout_marginEnd="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AI Accuracy" android:textColor="#64748B" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="94.7%" android:textColor="#FF4D6D"
                        android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/dark_card_bg">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Response" android:textColor="#64748B" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="&lt;2 sec" android:textColor="#FF4D6D"
                        android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/dark_card_bg">

                <ImageView
                    android:id="@+id/ivRadarBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="0.18"
                    android:src="@android:drawable/screen_background_dark" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_marginEnd="16dp">

                        <View
                            android:id="@+id/radarRing1"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/ring_drawable"
                            android:alpha="0.3" />

                        <View
                            android:id="@+id/radarRing2"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:background="@drawable/ring_drawable"
                            android:alpha="0.5" />

                        <View
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:background="@drawable/icon_circle_pink" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RADAR ACTIVE"
                            android:textColor="#FF4D6D"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12"
                            android:layout_marginBottom="5dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scanning for survivors in real-time"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YOLOv8 · Firebase · CameraX"
                            android:textColor="#64748B"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/dark_card_bg"
                    android:layout_marginBottom="12dp">
                    <View android:layout_width="match_parent" android:layout_height="3dp"
                        android:background="@drawable/alert_header_bg" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:orientation="vertical" android:padding="20dp">

                        <LinearLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/icon_circle_pink"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="#FFFFFF" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Survivor Detection" android:textColor="#FFFFFF"
                            android:textSize="17sp" android:textStyle="bold" android:layout_marginBottom="14dp" />
                        <Button android:id="@+id/btnStartDetection"
                            android:layout_width="match_parent" android:layout_height="50dp"
                            android:text="OPEN LIVE SCANNER" android:textColor="#FFFFFF"
                            android:textStyle="bold" android:background="@drawable/button_logout_bg"
                            android:layout_marginBottom="8dp" />
                        <Button android:id="@+id/btnUploadImage"
                            android:layout_width="match_parent" android:layout_height="48dp"
                            android:text="UPLOAD FROM GALLERY" android:textColor="#FFFFFF"
                            android:background="@drawable/info_row_dark" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnSOS"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="EMERGENCY SOS"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/sos_button_bg"
                    android:layout_marginBottom="12dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/dark_card_bg"
                    android:padding="16dp" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <View android:layout_width="4dp" android:layout_height="16dp"
                            android:background="#FF4D6D" android:layout_marginEnd="8dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="LATEST ALERT STATUS"
                            android:textColor="#FF4D6D" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:background="@drawable/info_row_dark"
                        android:padding="12dp" android:orientation="horizontal">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="#FF4D6D" android:layout_marginEnd="10dp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="GPS LOCATION" android:textColor="#3A4A60" android:textSize="9sp" />
                            <TextView android:id="@+id/tvLastAlertLocation"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Fetching Address..." android:textColor="#FFFFFF" android:textSize="13sp" />
                            <TextView android:id="@+id/tvCoordinates"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.0, 0.0" android:textColor="#64748B" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/dark_card_bg"
                    android:padding="16dp" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <View android:layout_width="4dp" android:layout_height="16dp"
                            android:background="#FF4D6D" android:layout_marginEnd="8dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ACTIVE RESCUE TEAMS" android:textColor="#FFFFFF"
                            android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRescueTeams"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="150dp"
                        android:overScrollMode="never" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/dark_card_bg"
                    android:padding="16dp">
                    <Button android:id="@+id/btnGeneratePdf"
                        android:layout_width="match_parent" android:layout_height="50dp"
                        android:text="GENERATE SAFETY LOG" android:textColor="#FFFFFF"
                        android:textStyle="bold" android:background="@drawable/button_logout_bg"
                        android:layout_marginBottom="10dp" />
                    <Button android:id="@+id/btnPanicSiren"
                        android:layout_width="match_parent" android:layout_height="50dp"
                        android:text="ACTIVATE PANIC SIREN" android:textColor="#FF4D6D"
                        android:textStyle="bold" android:background="@drawable/info_row_dark" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:orientation="horizontal"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:elevation="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout android:id="@+id/navHome"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_today"
                android:layout_marginBottom="4dp" app:tint="#FF4D6D" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Home" android:textColor="#FF4D6D" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navMap"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                android:src="@android:drawable/ic_dialog_map"
                android:layout_marginBottom="4dp" app:tint="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Map" android:textColor="#64748B" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navProfile"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="54dp" android:layout_height="54dp"
                android:gravity="center" android:background="@drawable/icon_circle_pink">
                <ImageView android:layout_width="32dp" android:layout_height="32dp"
                    android:src="@drawable/ic_person_placeholder" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/navHistory"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_recent_history"
                android:layout_marginBottom="4dp" app:tint="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="History" android:textColor="#64748B" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navAbout"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_info_details"
                android:layout_marginBottom="4dp" app:tint="#64748B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="About" android:textColor="#64748B" android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>