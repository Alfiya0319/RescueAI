<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F0F">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="48dp" android:paddingBottom="16dp">

        <ImageView android:id="@+id/btnBack"
            android:layout_width="36dp" android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert"
            android:layout_marginEnd="12dp"
            android:clickable="true" android:focusable="true"
            app:tint="#FF4D6D" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RescueAI" android:textColor="#64748B" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Survivor Detection" android:textColor="#FFFFFF"
                android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="32dp">

            <LinearLayout android:id="@+id/layoutPickZone"
                android:layout_width="match_parent" android:layout_height="180dp"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/upload_dashed_bg"
                android:layout_marginBottom="14dp"
                android:clickable="true" android:focusable="true">

                <LinearLayout android:layout_width="64dp" android:layout_height="64dp"
                    android:gravity="center" android:background="@drawable/icon_circle_pink"
                    android:layout_marginBottom="12dp">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@android:drawable/ic_menu_gallery" app:tint="#FF4D6D" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tap to select image" android:textColor="#FFFFFF"
                    android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="JPG, PNG, WEBP · Max 10 MB" android:textColor="#64748B" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/layoutPreview"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/dark_card_bg"
                android:padding="16dp" android:layout_marginBottom="14dp"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PREVIEW" android:textColor="#FF4D6D"
                    android:textSize="11sp" android:textStyle="bold"
                    android:letterSpacing="0.12" android:layout_marginBottom="10dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent" android:layout_height="200dp"
                    app:cardCornerRadius="10dp" app:cardElevation="0dp" app:cardBackgroundColor="#1A1A1A">
                    <ImageView android:id="@+id/ivPreview"
                        android:layout_width="match_parent" android:layout_height="200dp"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvFileName"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="image.jpg" android:textColor="#FFFFFF"
                            android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvFileSize"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—" android:textColor="#64748B" android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView android:id="@+id/btnRemoveImage"
                        android:layout_width="32dp" android:layout_height="32dp"
                        android:src="@android:drawable/ic_delete"
                        android:clickable="true" android:focusable="true" app:tint="#FF4D6D" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="14dp">

                <LinearLayout android:id="@+id/btnOpenCamera"
                    android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
                    android:gravity="center" android:orientation="horizontal"
                    android:background="@drawable/info_row_dark" android:layout_marginEnd="8dp"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:layout_marginEnd="8dp" app:tint="#FF4D6D" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Camera" android:textColor="#FFFFFF"
                        android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btnOpenGallery"
                    android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
                    android:gravity="center" android:orientation="horizontal"
                    android:background="@drawable/info_row_dark"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:layout_marginEnd="8dp" app:tint="#FF4D6D" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Gallery" android:textColor="#FFFFFF"
                        android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/layoutResult"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/dark_card_bg"
                android:padding="16dp" android:layout_marginBottom="14dp"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <View android:layout_width="4dp" android:layout_height="18dp"
                        android:background="#FF4D6D" android:layout_marginEnd="10dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DETECTION RESULT" android:textColor="#FF4D6D"
                        android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/info_row_dark"
                    android:padding="16dp" android:layout_marginBottom="14dp">

                    <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                        android:gravity="center" android:background="@drawable/icon_circle_pink"
                        android:layout_marginEnd="14dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@android:drawable/ic_menu_myplaces" app:tint="#FF4D6D" />
                    </LinearLayout>

                    <TextView android:id="@+id/tvSurvivorCount"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Detecting…"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" android:textStyle="bold" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp" app:cardElevation="0dp" app:cardBackgroundColor="#1A1A1A">
                    <ImageView android:id="@+id/ivAnnotated"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout android:id="@+id/layoutProgress"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/dark_card_bg"
                android:padding="16dp" android:layout_marginBottom="14dp"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/tvDetectionStatus"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Processing…"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvProgressPct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textColor="#FF4D6D"
                        android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar android:id="@+id/progressUpload"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="6dp"
                    android:max="100" android:progress="0"
                    android:progressTint="#FF4D6D" android:progressBackgroundTint="#1E1E1E" />
            </LinearLayout>

            <Button android:id="@+id/btnDetectAndUpload"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="DETECT SURVIVORS &amp; UPLOAD"
                android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
                android:background="@drawable/button_logout_bg"
                android:layout_marginBottom="10dp" />

            <Button android:id="@+id/btnGenerateReport"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="GENERATE REPORT"
                android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
                android:background="@drawable/info_row_dark"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <TextView android:id="@+id/tvCancel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Cancel" android:textColor="#64748B" android:textSize="14sp"
                android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp"
                android:clickable="true" android:focusable="true" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>