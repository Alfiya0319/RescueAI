<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rescue Command"
                android:textColor="#64748B"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvRescuerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp">
            <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:background="@drawable/info_row_dark"
                android:clickable="true" android:focusable="true">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@android:drawable/ic_popup_reminder"
                    app:tint="#FFFFFF" />
            </LinearLayout>
            <TextView android:id="@+id/tvNotifBadge"
                android:layout_width="18dp" android:layout_height="18dp"
                android:gravity="center" android:text="0"
                android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/icon_circle_pink"
                android:layout_gravity="top|end" />
        </FrameLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1A1A1A">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_placeholder" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="16dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="64dp"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical"
            android:background="@drawable/dark_card_bg" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/tvTotalAlerts"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="#FF4D6D"
                android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Total Alerts" android:textColor="#64748B" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="64dp"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical"
            android:background="@drawable/dark_card_bg" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/tvRescued"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="#22C55E"
                android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Rescuead" android:textColor="#64748B" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="64dp"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical"
            android:background="@drawable/dark_card_bg">
            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                android:src="@android:drawable/presence_online"
                android:layout_marginBottom="4dp" app:tint="#22C55E" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="On Duty" android:textColor="#64748B" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <LinearLayout android:id="@+id/btnStartDetection"
                    android:layout_width="0dp" android:layout_height="84dp" android:layout_weight="1"
                    android:gravity="center" android:orientation="vertical"
                    android:background="@drawable/dark_card_bg"
                    android:layout_marginEnd="8dp"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:layout_marginBottom="6dp" app:tint="#FF4D6D" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Scan" android:textColor="#94A3B8" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btnMap"
                    android:layout_width="0dp" android:layout_height="84dp" android:layout_weight="1"
                    android:gravity="center" android:orientation="vertical"
                    android:background="@drawable/dark_card_bg"
                    android:layout_marginEnd="8dp"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@android:drawable/ic_dialog_map"
                        android:layout_marginBottom="6dp" app:tint="#FF4D6D" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Map" android:textColor="#94A3B8" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btnSendAlert"
                    android:layout_width="0dp" android:layout_height="84dp" android:layout_weight="1"
                    android:gravity="center" android:orientation="vertical"
                    android:background="@drawable/dark_card_bg"
                    android:layout_marginEnd="8dp"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@android:drawable/ic_menu_send"
                        android:layout_marginBottom="6dp" app:tint="#FF4D6D" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Send Alert" android:textColor="#94A3B8" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btnHistory"
                    android:layout_width="0dp" android:layout_height="84dp" android:layout_weight="1"
                    android:gravity="center" android:orientation="vertical"
                    android:background="@drawable/dark_card_bg"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@android:drawable/ic_menu_recent_history"
                        android:layout_marginBottom="6dp" app:tint="#FF4D6D" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="History" android:textColor="#94A3B8" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <View android:layout_width="4dp" android:layout_height="18dp"
                    android:background="#FF4D6D" android:layout_marginEnd="10dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="LIVE ALERT FEED"
                    android:textColor="#FF4D6D" android:textSize="11sp"
                    android:textStyle="bold" android:letterSpacing="0.12" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="8dp" android:layout_height="8dp"
                        android:src="@android:drawable/presence_online"
                        android:layout_marginEnd="5dp" app:tint="#22C55E" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LIVE" android:textColor="#22C55E"
                        android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/emptyState"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:orientation="vertical"
                android:background="@drawable/dark_card_bg"
                android:padding="40dp" android:layout_marginBottom="14dp"
                android:visibility="visible">
                <ImageView android:layout_width="48dp" android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:layout_marginBottom="12dp" app:tint="#22C55E" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="No Active Alerts" android:textColor="#FFFFFF"
                    android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="6dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="All clear. You will be notified instantly when a survivor is detected."
                    android:textColor="#64748B" android:textSize="13sp"
                    android:gravity="center" android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLiveAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <Button android:id="@+id/btnNavigate"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="Navigate to Survivor"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:background="@drawable/button_logout_bg"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <Button android:id="@+id/btnMarkRescued"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="Mark as Rescued"
                android:textColor="#22C55E" android:textSize="15sp" android:textStyle="bold"
                android:background="@drawable/info_row_dark"
                android:layout_marginBottom="14dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cardAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/dark_card_bg"
                android:padding="20dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:background="@drawable/icon_circle_pink"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ℹ"
                        android:textColor="#FF4D6D"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About RescueAI"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOLOv8 · Firebase · CameraX · v1.0"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#FF4D6D"
                    android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/dark_card_bg"
                android:padding="20dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <View android:layout_width="4dp" android:layout_height="18dp"
                        android:background="#FF4D6D" android:layout_marginEnd="10dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="MEDIA &amp; REPORTS" android:textColor="#FF4D6D"
                        android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <Button android:id="@+id/btnUploadImage"
                        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:text="Upload Image" android:textColor="#FFFFFF" android:textSize="13sp"
                        android:textStyle="bold" android:background="@drawable/info_row_dark"
                        android:layout_marginEnd="8dp" />
                    <Button android:id="@+id/btnUploadVideo"
                        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:text="Upload Video" android:textColor="#FFFFFF" android:textSize="13sp"
                        android:textStyle="bold" android:background="@drawable/info_row_dark" />
                </LinearLayout>

                <Button android:id="@+id/btnGeneratePdf"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="Generate PDF Report" android:textColor="#FFFFFF"
                    android:textSize="14sp" android:textStyle="bold"
                    android:background="@drawable/button_logout_bg" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:background="@drawable/dark_card_bg"
    android:gravity="center">

    <LinearLayout android:id="@+id/navHome"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:orientation="vertical"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_today"
            android:layout_marginBottom="3dp" app:tint="#FF4D6D" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Home" android:textColor="#FF4D6D" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navMap"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:orientation="vertical"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp"
            android:src="@android:drawable/ic_dialog_map"
            android:layout_marginBottom="3dp" app:tint="#64748B" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Map" android:textColor="#64748B" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navProfile"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:orientation="vertical"
        android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:background="@drawable/icon_circle_pink">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/navAlerts"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:orientation="vertical"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp"
            android:src="@android:drawable/ic_popup_reminder"
            android:layout_marginBottom="3dp" app:tint="#64748B" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Alerts" android:textColor="#64748B" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navAbout"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:orientation="vertical"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:layout_marginBottom="3dp" app:tint="#64748B" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="About" android:textColor="#64748B" android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>

</LinearLayout>